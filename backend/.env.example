# backend/.env のサンプル。値を設定して .env にコピーしてください（.env はコミットしない）。

# --- エージェント（Claude Agent SDK）用の認証 ---
# 方法A: API キーを設定する
ANTHROPIC_API_KEY=

# 方法B: ネイティブ版 Claude Code にログイン済みなら未設定でも可。
# Windows では npm の claude.cmd シムは使えないため、ネイティブ claude.exe が必要:
#   PowerShell:  irm https://claude.ai/install.ps1 | iex
# 別の場所にある claude.exe を使う場合はフルパスを指定:
# CLAUDE_CODE_PATH=C:\Users\you\.local\bin\claude.exe

# --- モデル（エイリアス推奨: sonnet / opus / haiku）---
KG_MAIN_MODEL=sonnet
KG_SUB_MODEL=sonnet

# --- その他 ---
KG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KG_MAX_TURNS=20
